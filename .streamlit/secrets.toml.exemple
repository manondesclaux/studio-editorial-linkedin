# Copiez ce fichier en .streamlit/secrets.toml (il n'est jamais envoyé sur GitHub)
# et remplacez les valeurs. Sur Streamlit Community Cloud, collez le même contenu
# dans Settings → Secrets.

# Supabase → Connect → Session pooler (compatible IPv4). Remplacez [YOUR-PASSWORD].
DATABASE_URL = "postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Facultatif : clé API Anthropic pour « Améliorer la rédaction » et la conversation IA.
# ANTHROPIC_API_KEY = "sk-ant-..."
