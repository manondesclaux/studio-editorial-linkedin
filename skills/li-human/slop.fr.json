  "structures": [
    {
      "id": "pas-juste",
      "regex": "(?i)\\bce n['’]est pas (?:juste|seulement|simplement|qu['’]une?)\\b[^.!?\\n]{2,60}[,.] c['’]est\\b",
      "name": "« Ce n'est pas juste X, c'est Y »",
      "fix": "Dites la seule chose que vous pensez. Supprimez la mise en place."
    },
    {
      "id": "non-seulement",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
      "name": "« Non seulement X mais aussi Y »",
      "fix": "Deux phrases, ou gardez la meilleure moitié."
    },
    {
      "id": "il-sagit",
      "regex": "(?i)\\bil ne s['’]agit pas (?:de|d['’]|du|des)[^.!?\\n]{2,60}[.!] il s['’]agit\\b",
      "name": "« Il ne s'agit pas de X. Il s'agit de Y. »",
      "fix": "Commencez par Y. Le retournement est le tic."
    },
    {
      "id": "le-resultat",
      "regex": "(?i)^\\s*(?:le résultat|la suite|le pire|le meilleur|la clé|le secret|la vérité|la leçon)\\s*\\?\\s*$",
      "name": "Question rhétorique d'un mot",
      "fix": "Répondez dans la phrase au lieu de mettre en scène la révélation."
    },
    {
      "id": "voici-ce-que",
      "regex": "(?i)\\bvoici ce que (?:j['’]ai|nous avons|on a) appris\\b",
      "name": "« Voici ce que j'ai appris »",
      "fix": "Donnez la leçon directement."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+ et \\w+\\.",
      "name": "Triade (règle de trois)",
      "fix": "Deux éléments ou quatre. Trois est le rythme par défaut du modèle."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "Three hashtags. LinkedIn stopped rewarding the wall."
    },
    {
      "id": "en-tant-qu-ia",
      "regex": "(?i)\\ben tant qu['’](?:ia|intelligence artificielle|modèle de langage)\\b",
      "name": "Auto-référence du modèle",
      "fix": "Supprimez la phrase."
    },
    {
      "id": "en-resume",
      "regex": "(?i)^\\s*(?:en résumé|pour résumer|en conclusion|pour conclure)\\b",
      "name": "Ouverture de conclusion de dissertation",
      "fix": "Un post n'a pas besoin de paragraphe de conclusion."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)(?:qu['’]en pensez-vous|vous en pensez quoi|d['’]accord|qui d['’]autre|ai-je tort|et vous)\\s*\\?\\s*$",
      "name": "Appât à engagement réflexe",
      "fix": "Posez une question que seul ce post peut poser."
    }
  ]
